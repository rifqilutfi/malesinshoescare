// CleanStride — Prisma Schema (LOCKED)
// Do not modify without team agreement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// User — admin login only
// ──────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ──────────────────────────────────────────────
// Customer — public booking, no login
// phone is unique (reuse key), email is NOT unique
// address is optional
// ──────────────────────────────────────────────
model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String   @unique @db.VarChar(20)
  address   String?  @db.Text
  email     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("customers")
}

// ──────────────────────────────────────────────
// Category — service categories
// ──────────────────────────────────────────────
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("categories")
}

// ──────────────────────────────────────────────
// Service — shoe cleaning packages
// ──────────────────────────────────────────────
model Service {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  duration    String   @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  categoryId  Int?     @map("category_id")
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([categoryId])
  @@map("services")
}

// ──────────────────────────────────────────────
// Order — core business entity
// ──────────────────────────────────────────────
model Order {
  id                  Int         @id @default(autoincrement())
  orderNumber         String      @unique @map("order_number") @db.VarChar(20)
  customerId          Int         @map("customer_id")
  serviceId           Int         @map("service_id")
  shoeType            String      @map("shoe_type") @db.VarChar(50)
  quantity            Int         @default(1) @db.UnsignedInt
  notes               String?     @db.Text
  pickupDate          DateTime    @map("pickup_date") @db.Date
  pickupTime          String      @map("pickup_time") @db.VarChar(20)
  isUrgent            Boolean     @default(false) @map("is_urgent")
  status              OrderStatus @default(PENDING)
  progress            Int         @default(0) @db.UnsignedTinyInt
  estimatedCompletion DateTime?   @map("estimated_completion") @db.Date
  subtotal            Decimal     @db.Decimal(12, 2)
  urgentFee           Decimal     @default(0) @map("urgent_fee") @db.Decimal(12, 2)
  total               Decimal     @db.Decimal(12, 2)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  timeline OrderTimeline[]
  photos   ShoePhoto[]

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  PENDING    @map("pending")
  PICKUP     @map("pickup")
  PROCESSING @map("processing")
  QC         @map("qc")
  READY      @map("ready")
  DELIVERY   @map("delivery")
  COMPLETED  @map("completed")
  CANCELLED  @map("cancelled")
}

// ──────────────────────────────────────────────
// OrderTimeline — step-by-step tracking
// ──────────────────────────────────────────────
model OrderTimeline {
  id          Int       @id @default(autoincrement())
  orderId     Int       @map("order_id")
  step        String    @db.VarChar(50)
  description String    @db.Text
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timeline")
}

// ──────────────────────────────────────────────
// ShoePhoto — before/after images (schema only, not implemented in MVP)
// ──────────────────────────────────────────────
model ShoePhoto {
  id        Int       @id @default(autoincrement())
  orderId   Int       @map("order_id")
  filePath  String    @map("file_path") @db.VarChar(500)
  type      PhotoType @default(BEFORE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shoe_photos")
}

enum PhotoType {
  BEFORE @map("before")
  AFTER  @map("after")
}
